---
// Résumé, two ways from one source (data/resume.js):
//  - on screen: the web version, in the portfolio's styling
//  - in print: a plain one-page Letter résumé (black on white, single column, real text
//    so applicant-tracking systems can read it). tools/resume_pdf.mjs prints this page
//    to public/resume/jack-motzkin-resume.pdf after `npm run build`.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { RESUME_DATA as R } from '../data/resume.js';
import { RESUME } from '../data/site.js';

// an employer's overall dates: the oldest role's start to the newest role's end
const span = (roles) => {
  const start = roles[roles.length - 1].dates.split('–')[0].trim();
  const end = roles[0].dates.split('–')[1].trim();
  return `${start} – ${end}`;
};
---
<Base
  title="Résumé — Jack Motzkin"
  description="Résumé of Jack Motzkin, entry-level UX researcher: user interviews, usability testing, surveys, card sorting, tree testing and journey mapping; open to UX research, business analyst and customer insights roles."
>
  <Nav />
  <main id="main" class="resume-main">
    <article class="resume wrap">
      <header class="r-head">
        <div>
          <h1 class="r-name">{R.name}</h1>
          <p class="r-headline">{R.headline}</p>
        </div>
        <p class="r-contact">
          <span>{R.location}</span>
          <a href={`mailto:${R.email}`}>{R.email}</a>
          {R.phone && <a href={`tel:${R.phone.replace(/[^\d+]/g, '')}`}>{R.phone}</a>}
          {R.links.map((l) => <a href={l.href}>{l.label}</a>)}
        </p>
        {RESUME.pdf && (
          <p class="r-actions"><a class="btn btn-primary" href={RESUME.pdf} download>Download PDF</a></p>
        )}
      </header>

      <section class="r-sec">
        <h2 class="r-h">Summary</h2>
        <p class="r-summary">{R.summary}</p>
      </section>

      <section class="r-sec">
        <h2 class="r-h">Experience</h2>
        {R.experience.map((job) => (
          <div class="r-job">
            <div class="r-job-head">
              <h3 class="r-org">{job.org}<span class="r-where"> · {job.where}</span></h3>
              <span class="r-dates">{span(job.roles)}</span>
            </div>
            <p class="r-roles">
              {job.roles.map((r, i) => (
                <span class="r-role">{r.title}{job.roles.length > 1 && <span class="r-role-dates"> ({r.dates})</span>}{i < job.roles.length - 1 && <span class="r-sep"> · </span>}</span>
              ))}
            </p>
            <ul class="r-bullets">{job.bullets.map((b) => <li>{b}</li>)}</ul>
          </div>
        ))}
        <p class="r-earlier">{R.earlier}</p>
      </section>

      <section class="r-sec">
        <h2 class="r-h">Skills</h2>
        <dl class="r-skills">
          {R.skills.map((s) => (<div><dt>{s.k}</dt><dd>{s.v}</dd></div>))}
        </dl>
      </section>

      <div class="r-two">
        <section class="r-sec">
          <h2 class="r-h">Education</h2>
          <ul class="r-plain">
            {R.education.map((e) => (<li><b>{e.school}</b> · {e.what} <span class="r-dates-inline">({e.dates})</span></li>))}
          </ul>
        </section>
        <section class="r-sec">
          <h2 class="r-h">Certifications</h2>
          <ul class="r-plain">{R.certifications.map((c) => <li>{c}</li>)}</ul>
        </section>
      </div>
      <section class="r-sec">
        <h2 class="r-h">Awards &amp; Languages</h2>
        <p class="r-also">{R.awards}</p>
      </section>
    </article>
  </main>
  <Footer />
</Base>

<style>
  /* ---------- screen: the web version ---------- */
  .resume-main{padding:120px 0 clamp(64px,9vw,110px)}
  .resume{max-width:900px}
  .r-head{display:flex;flex-direction:column;gap:14px;padding-bottom:28px;border-bottom:1px solid var(--line)}
  .r-name{font-size:clamp(2.6rem,7vw,4.4rem);text-transform:uppercase;letter-spacing:-.02em;line-height:.95}
  .r-headline{margin:6px 0 0;font-family:var(--mono);font-size:13px;letter-spacing:.16em;text-transform:uppercase;color:var(--gold)}
  .r-contact{display:flex;flex-wrap:wrap;gap:6px 18px;margin:0;color:var(--ink-soft);font-size:14.5px}
  .r-contact a{color:var(--ink);text-decoration:underline;text-decoration-color:var(--line-2);text-underline-offset:3px}
  .r-contact a:hover{color:var(--gold);text-decoration-color:currentColor}
  .r-actions{margin:4px 0 0}

  .r-sec{margin-top:34px}
  .r-h{margin:0 0 14px;font-family:var(--mono);font-size:12px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;color:var(--gold)}
  .r-summary{margin:0;max-width:70ch;color:var(--ink);font-size:1.05rem;line-height:1.7}

  .r-job{padding:18px 0;border-top:1px solid var(--line)}
  .r-job:first-of-type{border-top:0;padding-top:0}
  .r-job-head{display:flex;justify-content:space-between;align-items:baseline;gap:6px 18px;flex-wrap:wrap}
  .r-org{margin:0;font-size:1.25rem;line-height:1.2}
  .r-where{font-family:var(--body);font-weight:400;font-size:.95rem;color:var(--ink-soft)}
  .r-dates,.r-dates-inline{font-family:var(--mono);font-size:12px;letter-spacing:.06em;color:var(--muted-fg);white-space:nowrap}
  .r-roles{margin:4px 0 10px;color:var(--gold);font-size:14.5px}
  .r-role-dates{color:var(--ink-soft)}
  .r-sep{color:var(--muted-fg)}
  .r-bullets{margin:0;padding-left:1.1em;display:flex;flex-direction:column;gap:7px;color:var(--ink-soft);line-height:1.6;max-width:72ch}
  .r-bullets li::marker{color:var(--gold)}
  .r-earlier{margin:16px 0 0;padding-top:16px;border-top:1px solid var(--line);color:var(--ink-soft);font-size:14.5px;line-height:1.6;max-width:72ch}

  .r-skills{margin:0;display:flex;flex-direction:column;gap:10px}
  .r-skills div{display:grid;grid-template-columns:130px 1fr;gap:16px}
  .r-skills dt{font-family:var(--display);font-weight:700}
  .r-skills dd{margin:0;color:var(--ink-soft);line-height:1.6}
  @media (max-width:600px){.r-skills div{grid-template-columns:1fr;gap:2px}}

  .r-two{display:grid;grid-template-columns:1fr 1fr;gap:0 40px}
  @media (max-width:760px){.r-two{grid-template-columns:1fr}}
  .r-plain{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:8px;color:var(--ink-soft);line-height:1.5}
  .r-plain b{color:var(--ink);font-weight:600}
  .r-also{margin:0;color:var(--ink-soft);font-size:14.5px}

  /* ---------- print: the one-page PDF ---------- */
  @page{size:Letter;margin:0.4in 0.5in}
  @media print{
    :global(:root){--bg:#fff;--ink:#111;--ink-soft:#222;--muted-fg:#555;--line:#cfcfcf;--gold:#111;color-scheme:light !important}
    :global(html),:global(body){background:#fff !important;color:#111}
    :global(.nav),:global(.mobile-menu),:global(.footer),:global(.grid-canvas),:global(.grid-vignette),:global(.skip){display:none !important}
    .resume-main{padding:0}
    .resume{max-width:none;padding:0;font-family:var(--body);font-size:9.3pt;line-height:1.32;color:#111}
    .r-actions{display:none}
    .r-head{flex-direction:row;justify-content:space-between;align-items:flex-end;gap:8px 24px;padding-bottom:7pt;border-bottom:1.2pt solid #111}
    .r-name{font-size:21pt;letter-spacing:-.01em;line-height:1}
    .r-headline{margin-top:3pt;font-size:8.2pt;letter-spacing:.14em;color:#333}
    .r-contact{flex-direction:column;align-items:flex-end;gap:1pt;font-size:8.6pt;color:#222;text-align:right}
    .r-contact a{color:#111;text-decoration:none}
    .r-sec{margin-top:8pt}
    .r-h{margin:0 0 4pt;padding-bottom:2pt;border-bottom:.6pt solid #bbb;font-size:8.2pt;letter-spacing:.16em;color:#111}
    .r-summary{font-size:9.3pt;line-height:1.36;max-width:none;color:#111}
    .r-job{padding:5pt 0 0;border-top:0;break-inside:avoid}
    .r-job:first-of-type{padding-top:0}
    .r-org{font-size:10.6pt}
    .r-where{font-size:9pt;color:#444}
    .r-dates,.r-dates-inline{font-size:8.2pt;color:#444;letter-spacing:.02em}
    .r-roles{margin:0 0 1.5pt;font-size:9pt;font-style:italic;color:#222}
    .r-role-dates{color:#444}
    .r-bullets{gap:1.3pt;line-height:1.32;max-width:none;color:#111;padding-left:1.05em}
    .r-bullets li::marker{color:#111}
    .r-earlier{margin-top:5pt;padding-top:0;border-top:0;font-size:9pt;line-height:1.32;color:#222;max-width:none}
    .r-skills{gap:3pt}
    .r-skills div{grid-template-columns:76pt 1fr;gap:6pt}
    .r-skills dt{font-size:9.3pt}
    .r-skills dd{line-height:1.3;color:#111}
    .r-two{grid-template-columns:1fr 1.25fr;gap:0 18pt}
    .r-plain{gap:1.5pt;line-height:1.32;color:#111}
    .r-plain b{color:#111}
    .r-also{margin:0;font-size:9pt;color:#222}
  }
</style>
