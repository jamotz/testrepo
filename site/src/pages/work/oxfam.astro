---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const meta = [
  { k: 'Role', v: 'UX Research & Design' },
  { k: 'Client', v: 'Oxfam Australia' },
  { k: 'Location', v: 'Melbourne, AU' },
  { k: 'Engagement', v: 'Apprenticeship' },
];
const phases = [
  { n: '01', t: 'User research', d: 'Interviewed and observed real supporters to understand where the support experience and the MyOxfam portal were breaking down.' },
  { n: '02', t: 'Information architecture', d: 'Restructured the support pages and MyOxfam portal — reorganising content around how people actually look for help.' },
  { n: '03', t: 'Wireframes', d: 'Translated the new structure into low-fidelity wireframes to pressure-test the flow before visual design.' },
  { n: '04', t: 'Visual design', d: 'Implemented a new visual design for the pages, aligned to Oxfam’s brand and accessibility needs.' },
  { n: '05', t: 'Usability testing', d: 'Tested the proposed design with users, gathered feedback, and iterated to improve on the first pass.' },
  { n: '06', t: 'Stakeholder presentation', d: 'Presented the refined design and rationale to stakeholders for buy-in.' },
];
---
<Base
  accent="oxfam"
  title="Oxfam Support Redesign — Jack Motzkin"
  description="Case study: redesigning Oxfam Australia's support pages and the MyOxfam portal — research, information architecture, wireframes, visual design, and usability testing."
>
  <Nav />
  <main>
    <!-- Hero -->
    <header class="case-hero wrap">
      <a class="back" href="/#work">
        <svg width="16" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true"><path d="M17 6H2m0 0 5-5M2 6l5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        All work
      </a>
      <p class="case-eyebrow"><span class="idx">01</span><span class="rule"></span>Case study · UX Research &amp; Design</p>
      <h1 class="case-title" data-hero-name><span class="line"><span>Oxfam Support</span></span><span class="line"><span class="accent">Redesign</span></span></h1>
      <p class="case-lead" data-reveal>
        Restructuring Oxfam Australia’s support pages and the MyOxfam portal so supporters
        can actually find help — grounded in research, validated with real users.
      </p>
      <dl class="case-meta" data-reveal>
        {meta.map((m) => (
          <div><dt>{m.k}</dt><dd>{m.v}</dd></div>
        ))}
      </dl>
      <div class="case-banner" data-reveal aria-label="Project banner (image placeholder)">
        <span class="ph-label">Hero image — drop your Oxfam banner here</span>
      </div>
    </header>

    <!-- Overview -->
    <section class="section">
      <div class="wrap case-cols">
        <div data-reveal>
          <p class="eyebrow">Overview</p>
          <h2>About Oxfam Australia</h2>
          <p class="body-p">
            Oxfam Australia is an Australian-based charity that helps the Indigenous and
            impoverished populations in Australia and the surrounding countries.
          </p>
        </div>
        <div data-reveal>
          <p class="eyebrow">The brief</p>
          <h2>Make support easy to navigate</h2>
          <p class="body-p">
            Redesign a set of website pages and the information architecture to improve the
            experience within their support system, and restructure the MyOxfam portal —
            then validate the new design with real users before handing it to stakeholders.
          </p>
        </div>
      </div>
    </section>

    <!-- Approach -->
    <section class="section approach">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <h2>Approach</h2>
          <span class="idx">Research-led · six phases</span>
        </div>
        <ol class="phases">
          {phases.map((p) => (
            <li class="phase" data-reveal>
              <span class="phase-n">{p.n}</span>
              <div>
                <h3>{p.t}</h3>
                <p>{p.d}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Gallery -->
    <section class="section">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <h2>Selected screens</h2>
          <span class="idx">Add your artifacts</span>
        </div>
        <div class="gallery">
          <div class="ph tall" data-reveal><span class="ph-label">Wireframe / flow</span></div>
          <div class="ph" data-reveal><span class="ph-label">Before → after</span></div>
          <div class="ph" data-reveal><span class="ph-label">Final visual design</span></div>
        </div>
      </div>
    </section>

    <!-- Outcome -->
    <section class="section">
      <div class="wrap case-cols">
        <div data-reveal>
          <p class="eyebrow">Outcome</p>
          <h2>A clearer path to help</h2>
          <p class="body-p">
            The redesign gave supporters a more intuitive route through Oxfam’s support
            content and a restructured MyOxfam portal — improved through usability testing
            and presented to stakeholders for adoption.
          </p>
        </div>
        <ul class="outcome-list" data-reveal>
          <li><span class="mono-label">Research</span>Interviews &amp; usability testing with real supporters</li>
          <li><span class="mono-label">IA</span>New information architecture for support &amp; MyOxfam</li>
          <li><span class="mono-label">Design</span>Wireframes → validated visual design</li>
          <li><span class="mono-label">Delivery</span>Presented to stakeholders</li>
        </ul>
      </div>
    </section>

    <!-- Pagination -->
    <section class="section pager-sec">
      <div class="wrap pager">
        <a class="pager-link" href="/#work">
          <span class="mono-label">Back</span>
          <span class="pager-t">All work</span>
        </a>
        <a class="pager-link next" href="/work/origins">
          <span class="mono-label">Next project</span>
          <span class="pager-t">Origins App Redesign
            <svg width="18" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true"><path d="M1 6h15m0 0-5-5m5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
      </div>
    </section>

    <!-- CTA -->
    <section class="section cta-sec">
      <div class="wrap cta">
        <h2 data-reveal>Have a support experience that needs untangling?</h2>
        <a class="btn btn-primary" href="/#contact" data-reveal>Get in touch
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9m0 0-4-4m4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  main{padding-top:74px}
  .case-hero{padding:clamp(40px,7vw,80px) var(--pad) clamp(30px,4vw,48px)}
  .back{display:inline-flex;align-items:center;gap:9px;font-family:var(--mono);font-size:12px;
    letter-spacing:.12em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:34px;transition:color .2s}
  .back:hover{color:var(--gold)}
  .back svg{transition:transform .3s var(--ease-out)}
  .back:hover svg{transform:translateX(-4px)}
  .case-eyebrow{display:flex;align-items:center;gap:14px;font-family:var(--mono);font-size:12.5px;
    letter-spacing:.2em;text-transform:uppercase;color:var(--gold);margin-bottom:20px}
  .case-eyebrow .idx{font-family:var(--display);font-weight:700;color:var(--ink);font-size:14px}
  .case-eyebrow .rule{height:1px;width:min(120px,16vw);background:var(--line-2)}
  .case-title{font-size:clamp(2.6rem,8vw,6rem);text-transform:uppercase;letter-spacing:-.03em;line-height:.86}
  .case-title .line{display:block;overflow:hidden;padding-bottom:.02em}
  .case-title .accent{color:var(--gold)}
  .case-lead{max-width:56ch;margin-top:24px;font-size:clamp(1.05rem,1.8vw,1.3rem);
    line-height:1.6;color:var(--ink-soft)}
  .case-meta{display:grid;grid-template-columns:repeat(4,auto);gap:14px 44px;margin:36px 0 0;
    padding-top:26px;border-top:1px solid var(--line)}
  .case-meta div{display:flex;flex-direction:column;gap:5px}
  .case-meta dt{font-family:var(--mono);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted-fg)}
  .case-meta dd{margin:0;font-family:var(--display);font-weight:500;font-size:1.05rem}
  @media (max-width:640px){.case-meta{grid-template-columns:repeat(2,1fr)}}

  .case-banner{margin-top:40px;aspect-ratio:16/7;border-radius:var(--radius);
    border:1px solid var(--line-2);display:grid;place-items:center;overflow:hidden;
    background:
      radial-gradient(120% 130% at 80% 10%,color-mix(in srgb,var(--gold) 42%,transparent),transparent 60%),
      color-mix(in srgb,var(--gold) 12%,var(--panel))}

  .ph{position:relative;border-radius:var(--radius);border:1px dashed color-mix(in srgb,var(--gold) 40%,var(--line-2));
    background:color-mix(in srgb,var(--gold) 8%,var(--panel));min-height:220px;display:grid;place-items:center}
  .ph.tall{grid-row:span 2;min-height:100%}
  .ph-label{font-family:var(--mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;
    color:color-mix(in srgb,var(--gold) 70%,var(--ink-soft))}

  .case-cols{display:grid;grid-template-columns:1fr 1fr;gap:clamp(32px,5vw,64px);align-items:start}
  @media (max-width:820px){.case-cols{grid-template-columns:1fr;gap:34px}}
  .case-cols h2{font-size:clamp(1.6rem,3.4vw,2.4rem);text-transform:uppercase;margin:14px 0 16px}
  .body-p{color:var(--ink-soft);font-size:1.08rem;max-width:52ch}

  .phases{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:2px;
    border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;background:var(--line)}
  @media (max-width:760px){.phases{grid-template-columns:1fr}}
  .phase{display:flex;gap:20px;padding:28px;background:var(--bg);align-items:flex-start}
  .phase-n{font-family:var(--display);font-weight:700;font-size:1.1rem;color:var(--gold);
    padding-top:2px;min-width:2ch}
  .phase h3{font-size:1.2rem;margin-bottom:8px}
  .phase p{color:var(--ink-soft);font-size:14.5px;line-height:1.6}

  .gallery{display:grid;grid-template-columns:1.2fr 1fr;grid-auto-rows:1fr;gap:18px}
  @media (max-width:760px){.gallery{grid-template-columns:1fr}.ph.tall{grid-row:auto}}

  .outcome-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:0;
    border-top:1px solid var(--line)}
  .outcome-list li{display:grid;grid-template-columns:120px 1fr;gap:16px;padding:16px 0;
    border-bottom:1px solid var(--line);color:var(--ink);font-size:15px;align-items:center}
  .outcome-list .mono-label{color:var(--gold)}

  .pager{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .pager-link{display:flex;flex-direction:column;gap:8px;padding:28px;border:1px solid var(--line);
    border-radius:var(--radius);transition:border-color .3s,background-color .3s}
  .pager-link:hover{border-color:var(--gold);background:color-mix(in srgb,var(--gold) 6%,transparent)}
  .pager-link.next{text-align:right;align-items:flex-end}
  .pager-t{font-family:var(--display);font-weight:700;font-size:1.3rem;display:inline-flex;align-items:center;gap:10px}
  .pager-t svg{transition:transform .3s var(--ease-out)}
  .pager-link.next:hover .pager-t svg{transform:translateX(5px)}
  @media (max-width:600px){.pager{grid-template-columns:1fr}.pager-link.next{text-align:left;align-items:flex-start}}

  .cta-sec{border-top:1px solid var(--line)}
  .cta{display:flex;flex-direction:column;align-items:flex-start;gap:24px}
  .cta h2{font-size:clamp(1.8rem,4.5vw,3rem);text-transform:uppercase;max-width:20ch}
</style>
