---
// DRAFT — the leading underscore keeps Astro from building this page, so it stays off
// the live site. Preview it as its own artifact:  python3 site/tools/bundle_artifact.py --draft premier <out>
// To launch: rename to premier.astro, delete the .mock-badge, give the Work card href '/work/premier'.
// Content comes from Jack's Premier page on jackmotzkin.com (reference/premier/current-site/)
// and his journey map (reference/premier/journey-map/). What's still unknown is marked .draft.
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const meta = [
  { k: 'Role', v: 'CX Researcher' },
  { k: 'Client', v: 'Premier Packout' },
  { k: 'Location', v: 'Scottsdale, AZ' },
  { k: 'Partner', v: 'CEO, Premier Packout' },
];

// Section 09: client sentiment across the journey, read off the journey map's sentiment
// row (1 frustrated · 2 neutral · 3 happy · 4 delighted), one point per emoji on the map.
// Each point sits over its phase's column, so the line lines up with the phase tabs below;
// phases with two readings (start and end) get two points.
const mood = [1, 2, 3, 2, 3, 2, 3, 3, 1, 4, 1];
const moodPhase = [0, 1, 1, 2, 3, 3, 4, 5, 6, 6, 7];
const moodY = { 1: 150, 2: 110, 3: 70, 4: 30 };
const COL = 1000 / 8;
const moodPts = mood.map((m, i) => {
  const ph = moodPhase[i];
  const pair = moodPhase.filter((p) => p === ph).length > 1;
  const nudge = pair ? (moodPhase.indexOf(ph) === i ? -COL / 4 : COL / 4) : 0;
  return [(ph + 0.5) * COL + nudge, moodY[m]];
});

const research = [
  { n: '01', t: 'Semi-structured interviews', d: 'One-on-one with the CEO, managers, staff, and homeowners. Open-ended questions like “What was the most stressful part of the process for you?”' },
  { n: '02', t: 'Contextual inquiry', d: 'Shadowed crews in different roles: how packers wrap fragile items, what the inventory system demands, and where labeling breaks down.' },
  { n: '03', t: 'Satisfaction survey', d: 'Post-service ratings from 36 homeowners on a 7-point scale, from severely dissatisfied to very satisfied.' },
  { n: '04', t: 'Thematic analysis', d: 'Clustered interviews, support tickets, and online reviews into recurring pain points (delays, miscommunication, damaged goods) by journey stage.' },
];

// CSAT, 36 homeowners (7-point scale). Satisfied = top three ratings: 20 / 36 = 56%.
const csat = [
  { l: 'Very satisfied', n: 8, flood: 5, fire: 3, top: true },
  { l: '6', n: 5, flood: 2, fire: 3, top: true },
  { l: '5', n: 7, flood: 2, fire: 5, top: true },
  { l: '4', n: 3, flood: 2, fire: 1 },
  { l: '3', n: 6, flood: 5, fire: 1 },
  { l: '2', n: 4, flood: 4, fire: 0 },
  { l: 'Severely dissatisfied', n: 3, flood: 1, fire: 2 },
];
const csatMax = Math.max(...csat.map((r) => r.n));

const pillars = [
  { k: 'Website', d: 'Often the first touchpoint, and it was letting customers down: missing information, an outdated staff roster, bugs, and an unused portal. A redesign should show the process, from wrapping furniture to packing glass, and build confidence.' },
  { k: 'Staff & fleet', d: 'The CEO wants a premier “white glove” service. That means a strict dress code with a standard uniform, and vans repaired, repainted, and wrapped so every job doubles as advertising.' },
  { k: 'Workflow', d: 'Jobs slowed down at inventory, furniture wrapping, packing, and storage, especially in cluttered rooms and cabinets full of glassware. Better packing, truck loading, and warehouse storage speed up every job.' },
];
const headline = [
  'Be clear with homeowners about timelines',
  'Make pack-out more efficient by improving the process',
  'Boxes in second-level vaults, furniture on the ground level',
  'Assign a PM to each job who gets to know the homeowner',
];

// Found (journey map, company pain points) -> recommended (Operational Workflow)
const improvements = [
  { s: 'Marketing', now: 'Work comes mainly from recommendations. There is no advertising and the website looks unprofessional.', next: 'Preventative content (home-maintenance tips that cut fire and flood risk), targeted ads in high-risk areas, and referral partnerships with insurers, restoration firms, and property managers.' },
  { s: 'Pack-out', now: 'Slow inventorying holds up every job and delays completion.', next: 'A general inventory before packing starts, items packed together by where they came from, and color- or QR-coded room labels on pre-labeled packaging.' },
  { s: 'Storage', now: 'Vault space isn’t used well: boxes take up the lower vaults and heavy contents get stacked on top.', next: 'Boxes in upper vaults and furniture on the ground level, a weight limit per box, heaviest items at the bottom, and job-specific zones in the warehouse.' },
  { s: 'Cleaning', now: 'No one is taught how to clean properly, the team is too small for large jobs, and old laundry machines break down.', next: 'A dedicated cleaning and wrapping workspace, a task-priority system, clear roles, and maintained equipment.' },
  { s: 'Pack-back', now: 'Different crews each visit don’t know the project, and the inventory isn’t detailed enough to find items.', next: 'One PM per job who knows the homeowner, plus consistent labels: cabinets A–Z, sectional and bed parts, photos of electronics’ plugs.' },
];

const webMajor = [
  ['Broken links', 'the “Learn How” button leads to a 404'],
  ['Navigation', '“Our Services” and “Company” both redirect to the homepage'],
  ['Brand recognition', 'an unrecognizable Yelp logo and an unclear LinkedIn review section'],
  ['Address', 'a PO box instead of a business address'],
  ['Social proof', 'no customer reviews or testimonials'],
];
const webMinor = [
  ['Staff photos', 'outdated; current ones would build trust'],
  ['Typography', 'inconsistent sizing, especially in Contact Us'],
  ['Company story', '“25 years” vs. “15 years” of experience'],
  ['Service copy', 'too vague to say what the company actually does'],
];
const uniforms = [
  ['GM & management', 'white collared shirts'],
  ['Project managers', 'navy collared shirts'],
  ['Crew', 'grey collared shirts'],
  ['Bottoms', 'a choice of pants or shorts'],
];
const facility = ['Detailed, wrapped company vans', 'A deep-cleaned, reorganized warehouse', 'An office fit for client meetings', 'A new rug-storage system', 'A designated cleaning area'];

// Section 09: the eight phases of the journey map
const stages = [
  { id: 'marketing', n: '01', t: 'Marketing', mood: 'Frustrated',
    goal: 'Find a contents company to pack up their home after a fire or flood.',
    expect: 'Reliable, professional help that quickly clears affected areas, with an estimate in hand by the end of the day.',
    pain: 'Pack-out companies don’t advertise. It’s a once-in-a-lifetime emergency, and they’re displaced from home for an unknown amount of time.',
    company: 'No advertising, so work comes from recommendations. The website looks unprofessional and clients can’t visit the warehouse.' },
  { id: 'acquisition', n: '02', t: 'Work acquisition', mood: 'Neutral, then happy',
    goal: 'Find a company on their own, or take their renovator’s recommendation.',
    expect: 'A simple process, contents handled with care, and a transparent, white-glove operation.',
    pain: 'Few testimonials or trust signals, inconsistent communication channels, and an outdated website with unclear process details.',
    company: 'Verifying with insurance what will be salvaged, getting homeowners to follow the action plan, and fitting the pack-out in ASAP.' },
  { id: 'evaluation', n: '03', t: 'Evaluation', mood: 'Neutral',
    goal: 'Get an estimate and a schedule.',
    expect: 'The GM or estimator explains the process in detail, the estimate is accurate, and they know when the team will arrive.',
    pain: 'Price and duration may be higher than expected, signing is complex, there’s too much information at once, and insurance is involved.',
    company: 'Estimates may need adjusting, some jobs are out of scope, and upset homeowners may have to pay out of pocket.' },
  { id: 'packout', n: '04', t: 'Pack-out', mood: 'Happy, then neutral',
    goal: 'Get everything packed out, from the first day to the last.',
    expect: 'Workers on time in clean vehicles, fragile items carefully wrapped, a PM who communicates openly, and every item accounted for.',
    pain: 'Priceless items handled carelessly, the arrival time missed, the estimate far off, broken items, and the job not finished on time.',
    company: 'Storage units late, not knowing the full scope, running short of materials, and scope growing without enough staff.' },
  { id: 'storage', n: '05', t: 'Storage', mood: 'Happy',
    goal: 'Keep contents safe in the warehouse until pack-back.',
    expect: 'A secure, air-conditioned facility, photos of contents neatly stored, and every inch of vault space used.',
    pain: 'Poor communication, forgotten items now stored away, monthly payments for an unknown time, and items damaged by improper storage.',
    company: 'Too little storage, too little detail in the inventory, an unorganized process, and heavy contents stacked on top.' },
  { id: 'cleaning', n: '06', t: 'Cleaning', mood: 'Happy',
    goal: 'Get insurance-approved cleaning.',
    expect: 'Contents cleaned with no trace of fire or flood, no further damage, and a re-inventory after cleaning.',
    pain: 'Boxes still dirty or smelling of fire, items not cleaned to standard, and cleaning that can delay the timeline and raise costs.',
    company: 'No one is taught to clean properly (mostly just wiping down), old machines break down, and the team is too small for big jobs.' },
  { id: 'packback', n: '07', t: 'Pack-back', mood: 'Frustrated, then delighted',
    goal: 'Get everything back home, from the first day to the last.',
    expect: 'The same PM on the job, an accurate inventory, contents placed where they were, and all furniture reassembled.',
    pain: 'Not everything arrives on day one, contents go missing, furniture is assembled wrong, and it takes longer than expected.',
    company: 'Different crews every time, an inventory too thin to find items, and furniture or boxes missing in the warehouse.' },
  { id: 'aftercare', n: '08', t: 'Aftercare', mood: 'Frustrated',
    goal: 'Get damaged contents repaired.',
    expect: 'The company takes responsibility, repairs items at no cost, gives timeline updates, and restores items to their original condition.',
    pain: 'Poor-quality repairs (wrong colors, chips in wood, warped glass), incorrect replacements, and irreplaceable items that can only be approximated.',
    company: 'Extra costs for replacements and driver time, unhappy clients leaving bad reviews, and hours lost to searches (five for one bed remote).' },
];
---
<Base
  accent="premier"
  title="Premier CX Analysis — Jack Motzkin"
  description="Case study (draft): mapping the customer journey of Premier Packout, a fire & flood contents company, with its CEO — interviews, contextual inquiry, a 36-homeowner satisfaction survey, and a white-glove plan across the website, staff, and workflow."
>
  <Nav />
  <p class="mock-badge">Premier · mockup</p>
  <main>
    <!-- Hero: a finished pack-out, boxed and blanket-wrapped (Jack's photo) -->
    <header class="case-hero" id="case-top">
      <img class="case-hero-img" src="/work/premier/hero.jpg" alt="A room after a Premier pack-out: labeled moving boxes stacked to the ceiling and furniture wrapped in blue moving blankets and plastic" />
      <div class="case-hero-in wrap">
        <a class="back" href="/#work">
          <svg width="16" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true"><path d="M17 6H2m0 0 5-5M2 6l5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          All work
        </a>
        <p class="case-eyebrow"><span class="idx">03</span><span class="rule"></span>Case study · CX Research</p>
        <h1 class="case-title" data-hero-name><span class="line"><span>Premier CX</span></span><span class="line"><span class="accent">Analysis</span></span></h1>
        <p class="case-lead">
          Working with the CEO of a fire &amp; flood contents company to find where homeowners’ stress
          comes from, from pack-out through storage, cleaning, and pack-back, and to turn that into a
          white-glove service.
        </p>
      </div>
    </header>

    <div class="wrap">
      <div class="snapshot" data-reveal>
        <div class="snap-row"><span class="mono-label">My role</span><p>CX researcher, working with the CEO. I ran interviews, shadowed crews, analyzed a 36-homeowner satisfaction survey and online reviews, audited the website, and built the end-to-end journey map.</p></div>
        <div class="snap-row"><span class="mono-label">Outcome</span><p>An eight-phase journey map, a 56% satisfaction baseline, and a white-glove plan across the website, staff, and workflow. <a class="jump" href="#results">See results ↓</a></p></div>
      </div>
      <dl class="case-meta" data-reveal>
        {meta.map((m) => (<div><dt>{m.k}</dt><dd>{m.v}</dd></div>))}
      </dl>
    </div>

    <div class="wrap">
      <!-- 02 Problem -->
      <section class="csec" id="problem">
        <div class="shead" data-reveal><span class="n">02</span><h2>Problem overview</h2></div>
        <div class="two">
          <div data-reveal>
            <p class="lead">Premier Packout handles salvageable belongings after a fire or flood. It removes them from the home or business, has them professionally cleaned, stores them securely, and returns them once renovations are done.</p>
            <p class="body-p">Insurance companies, restoration companies, adjusters, and homeowners often miscommunicate. Meanwhile homeowners live through fragile items being packed, cleaned, stored, and moved, with no clear end date for the renovation. Coordinating all of that while keeping their belongings safe adds to an already stressful time.</p>
          </div>
          <div class="callout" data-reveal>Nobody chooses to need this service, so every handoff has to earn trust.</div>
        </div>
      </section>

      <!-- 03 Research -->
      <section class="csec" id="research">
        <div class="shead" data-reveal><span class="n">03</span><h2>Research approach</h2></div>
        <p class="lead" data-reveal>I combined what people said with what I saw them do, then checked both against the numbers.</p>
        <div class="cards" data-reveal>
          {research.map((c) => (
            <div class="card"><span class="k">{c.n}</span><div><h3>{c.t}</h3><p>{c.d}</p></div></div>
          ))}
        </div>
      </section>

      <!-- 04 Recommendations (CX relabel of "Design decisions") -->
      <section class="csec" id="recommendations">
        <div class="shead" data-reveal><span class="n">04</span><h2>Recommendations</h2></div>
        <div class="two">
          <div data-reveal>
            <p class="lead">My recommendations focused on better communication with renovation partners, a faster pack-out, better use of storage, and changes to staff management and the website.</p>
            <ul class="rows nums">
              {headline.map((h, i) => (<li><span class="mono-label">{String(i + 1).padStart(2, '0')}</span>{h}</li>))}
            </ul>
          </div>
          <div class="callout" data-reveal>The CEO wanted a premier, white-glove service. Every recommendation measures against that.</div>
        </div>
        <div class="pillars" data-reveal>
          {pillars.map((p) => (<div class="pillar"><span class="mono-label">{p.k}</span><p>{p.d}</p></div>))}
        </div>
      </section>

      <!-- 05 Service improvements (CX relabel of "Design format & iteration") -->
      <section class="csec" id="improvements">
        <div class="shead" data-reveal><span class="n">05</span><h2>Service improvements</h2></div>
        <p class="lead" data-reveal>Each fix answers a pain point the company itself named on the journey map.</p>
        <div class="imp" data-reveal>
          <div class="imp-head" aria-hidden="true"><span></span><span>What I found</span><span>What I recommended</span></div>
          {improvements.map((r) => (
            <div class="imp-row">
              <span class="imp-s">{r.s}</span>
              <p class="imp-now"><span class="imp-lab">What I found</span>{r.now}</p>
              <p class="imp-next"><span class="imp-lab">What I recommended</span>{r.next}</p>
            </div>
          ))}
        </div>

        <h3 class="subhead" data-reveal>Website audit</h3>
        <div class="two audit" data-reveal>
          <div><span class="mono-label">Major</span><ul class="dlist">{webMajor.map(([k, d]) => (<li><b>{k}:</b> {d}</li>))}</ul></div>
          <div><span class="mono-label">Minor</span><ul class="dlist">{webMinor.map(([k, d]) => (<li><b>{k}:</b> {d}</li>))}</ul></div>
        </div>

        <h3 class="subhead" data-reveal>Staff professionalism</h3>
        <p class="body-p" data-reveal>Premier works in high-end neighborhoods, but uniforms were stained and mismatched, and there were no standard pants or shorts. I proposed a uniform by role and a cleaner company presentation.</p>
        <div class="two staff" data-reveal>
          <div>
            <span class="mono-label">Uniform by role</span>
            <ul class="dlist">{uniforms.map(([k, d]) => (<li><b>{k}:</b> {d}</li>))}</ul>
            <span class="mono-label" style="display:block;margin-top:18px">Company &amp; facility</span>
            <ul class="dlist">{facility.map((f) => (<li>{f}</li>))}</ul>
          </div>
          <figure>
            <div class="frame light"><img src="/work/premier/van.jpg" alt="Proposed Premier Packout van wrap on a Mercedes Sprinter: a large logo on both sides and the rear doors, a sweeping blue lower wrap, the phone number, and the line Fire • Water • Contents" loading="lazy" /></div>
            <figcaption class="cap"><b>Van wrap concept</b> that turns the fleet into mobile advertising</figcaption>
          </figure>
        </div>
      </section>

      <!-- 06 Key insights (CX relabel of "Testing insights": this was research, not usability testing) -->
      <section class="csec" id="insights">
        <div class="shead" data-reveal><span class="n">06</span><h2>Key insights</h2></div>
        <div class="two">
          <div data-reveal>
            <div class="callout">The lowest points were the handoffs: finding help, the first day of pack-back, and aftercare.</div>
            <p class="body-p">Just over half of homeowners were satisfied, and one in five rated the service 2 or lower. Online sentiment leaned positive (13 of 18 mentions) but was thin: a 5.0 Google rating from only 2 reviews, and no reviews on Yelp. New customers had almost no social proof to go on.</p>
          </div>
          <figure class="csat" data-reveal>
            <figcaption class="csat-head">
              <span class="mono-label">Homeowner satisfaction · n = 36</span>
              <span class="csat-big">56%</span><span class="csat-sub">satisfied (top three ratings)</span>
            </figcaption>
            <ul class="bars">
              {csat.map((r) => (
                <li class:list={['bar-row', { top: r.top }]} tabindex="0" aria-label={`${r.l}: ${r.n} homeowners (${r.flood} flood, ${r.fire} fire)`}>
                  <span class="bar-l">{r.l}</span>
                  <span class="bar-track"><span class="bar" style={`width:${(r.n / csatMax) * 100}%`}></span></span>
                  <span class="bar-n">{r.n}</span>
                  <span class="tip" aria-hidden="true">{r.n} homeowners · {r.flood} flood, {r.fire} fire · {Math.round((r.n / 36) * 1000) / 10}%</span>
                </li>
              ))}
            </ul>
          </figure>
        </div>
        <div class="stats" data-reveal>
          <div class="stat"><div class="big">13<span class="of">/18</span></div><div class="statlab">Online mentions positive (4 negative, 1 neutral)</div></div>
          <div class="stat"><div class="big">2</div><div class="statlab">Google reviews, the only public ratings</div></div>
          <div class="stat"><div class="big">5</div><div class="statlab">Major website issues, from a 404 to a PO-box address</div></div>
        </div>
      </section>

      <!-- 07 Results -->
      <section class="csec" id="results">
        <div class="shead" data-reveal><span class="n">07</span><h2>Results</h2></div>
        <p class="lead" data-reveal>A shared, evidence-backed picture of the customer’s experience and a white-glove plan across three workstreams, delivered to the CEO. <span class="draft">[Add what Premier adopted, e.g. uniforms, van wraps, storage changes, the website.]</span></p>
        <div class="stats" data-reveal>
          <div class="stat"><div class="big">8</div><div class="statlab">Journey phases mapped, from marketing to aftercare</div></div>
          <div class="stat"><div class="big">56%</div><div class="statlab">Satisfaction baseline across 36 homeowners</div></div>
          <div class="stat"><div class="big">3</div><div class="statlab">Workstreams: website, staff &amp; fleet, operations</div></div>
        </div>
        <blockquote class="quote" data-reveal>
          <p><span class="draft">[A line from the CEO, or one thing Premier changed because of this work.]</span></p>
          <cite class="mono-label">CEO, Premier Packout</cite>
        </blockquote>
      </section>

      <!-- 08 Reflection -->
      <section class="csec" id="reflection">
        <div class="shead" data-reveal><span class="n">08</span><h2>Reflection</h2></div>
        <div class="two">
          <div class="callout" data-reveal>What I’d carry forward, and do differently next time.</div>
          <div data-reveal>
            <p class="body-p">This project showed me how much of an experience happens off-screen: in the truck, the warehouse, and the homeowner’s living room. Next time I’d set up a follow-up satisfaction survey from the start, so the 56% baseline could show whether the changes worked. <span class="draft">[Make it yours.]</span></p>
          </div>
        </div>
      </section>

      <!-- 09 Journey map & deliverable (CX relabel of the prototype section) -->
      <section class="csec" id="journey">
        <div class="shead" data-reveal><span class="n">09</span><h2>Journey map &amp; deliverable</h2></div>
        <p class="lead" data-reveal>I built the map from client interviews, observation of our workflow, and customer feedback, then organized it by theme to show the bottlenecks. Pick a phase to read it.</p>
        <div class="journey" data-reveal>
          <div class="jline">
            <div class="jline-head"><span class="mono-label">Client sentiment</span><span class="jline-hint">Click a point or a phase</span></div>
            <svg viewBox="0 0 1000 180" role="img" aria-label="Client sentiment across the journey: frustrated while finding help, neutral to happy through work acquisition, evaluation, pack-out, storage and cleaning, frustrated when pack-back starts, delighted when it ends, and frustrated in aftercare.">
              {stages.map((st, i) => (<rect class:list={['jband', { on: i === 0 }]} data-phase={i} x={i * COL} y="0" width={COL} height="180" />))}
              <polyline class="hj-line" points={moodPts.map((pt) => pt.join(',')).join(' ')} />
              {moodPts.map(([x, y], i) => (
                <circle class:list={['hj-dot', { low: mood[i] === 1, high: mood[i] === 4, on: moodPhase[i] === 0 }]} data-phase={moodPhase[i]} cx={x} cy={y} r="9" />
              ))}
            </svg>
          </div>
          <div class="jstrip" role="tablist" aria-label="Customer journey phases">
            {stages.map((s, i) => (
              <button class="jstage" role="tab" type="button" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`}
                aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                <span class="jn">{s.n}</span><span class="jt">{s.t}</span>
              </button>
            ))}
          </div>
          {stages.map((s, i) => (
            <div class="jpanel" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} hidden={i !== 0}>
              <div><span class="mono-label">Client goal</span><p>{s.goal}</p><span class="mono-label jmood">Sentiment</span><p>{s.mood}</p></div>
              <div><span class="mono-label">Client expects</span><p>{s.expect}</p></div>
              <div><span class="mono-label">Client pain points</span><p>{s.pain}</p></div>
              <div><span class="mono-label">Company pain points</span><p>{s.company}</p></div>
            </div>
          ))}
        </div>
        <h3 class="subhead" data-reveal>The full map</h3>
        <div class="map-scroll" tabindex="0" role="region" aria-label="Full journey map (scrolls sideways)" data-reveal>
          <img src="/work/premier/journey-map.jpg" alt="Premier Packout customer journey map. Goal: the client wants to find a contents company to pack up their home and store it until they can move back in. Eight phases (marketing, work acquisition, evaluation, pack-out, storage, cleaning, pack-back, aftercare) by client goals, sentiment, expectations, client pain points, and company pain points." loading="lazy" />
        </div>
        <p class="exp-hint" data-reveal>Scroll sideways to read it, or <a href="/work/premier/journey-map.jpg" target="_blank" rel="noopener">open it full size ↗</a></p>
      </section>
    </div>

    <section class="section pager-sec">
      <div class="wrap pager">
        <a class="pager-link" href="/#work">
          <span class="mono-label">Back</span>
          <span class="pager-t">All work</span>
        </a>
        <a class="pager-link next" href="/work/oxfam">
          <span class="mono-label">Next project</span>
          <span class="pager-t">Oxfam Support Redesign
            <svg width="18" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true"><path d="M1 6h15m0 0-5-5m5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  main{padding-top:0}

  .mock-badge{position:fixed;left:14px;bottom:14px;z-index:90;margin:0;padding:8px 12px;border-radius:8px;
    background:var(--gold);color:var(--bg);font-family:var(--mono);font-size:11px;font-weight:500;
    letter-spacing:.1em;text-transform:uppercase}

  /* Hero: no photo yet, so an accent glow sits over the site grid */
  .case-hero{position:relative;min-height:56vh;display:flex;align-items:flex-end;overflow:hidden;
    border-bottom:1px solid var(--line);
    background:radial-gradient(ellipse 70% 90% at 85% 10%,var(--gold-glow),transparent 70%)}
