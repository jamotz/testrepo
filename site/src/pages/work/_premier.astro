---
// DRAFT — the leading underscore keeps Astro from building this page, so it stays off
// the live site. Preview it as its own artifact:  python3 site/tools/bundle_artifact.py --draft premier <out>
// To launch: rename to premier.astro, delete the .mock-badge, give the Work card href '/work/premier'.
// Everything marked .draft is placeholder copy; every .slot is waiting on Jack's real artifacts.
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const meta = [
  { k: 'Role', v: 'CX Researcher' },
  { k: 'Client', v: 'Premier Packout' },
  { k: 'Location', v: 'Scottsdale, AZ' },
  { k: 'Partner', v: 'CEO, Premier Packout' },
];
const research = [
  { n: '01', t: 'CEO working sessions', d: 'Walked the service end to end with the CEO: what happens, who does it, and where customers get stuck.' },
  { n: '02', t: 'Journey mapping', d: 'Mapped every stage from first call to final pack-back, with the customer’s actions, questions, and feelings at each one.' },
  { n: '03', t: 'Touchpoint audit', d: 'Listed each moment the customer hears from Premier (calls, crews, paperwork, updates) and each stretch where they hear nothing.' },
  { n: '04', t: 'Pain-point synthesis', d: 'Grouped what surfaced into themes and ranked them by how much trust each one costs.' },
];
const recs = [
  { k: 'Visibility', d: 'Show customers what was packed, where it is, and what happens next.' },
  { k: 'Updates', d: 'Replace “call us for a status” with updates at set milestones.' },
  { k: 'Ownership', d: 'One coordinator owns the customer from pack-out to pack-back.' },
  { k: 'Restore calls', d: 'Explain restore-vs-replace decisions, with photos, before they are final.' },
  { k: 'Pack-back', d: 'Return items placed and checked off together, not boxes at the door.' },
];
const stages = [
  { id: 'pack', touch: 'Estimator visit · packing crew · contents inventory', n: '01', t: 'Pack',
    doing: 'The home was just flooded or burned. A crew arrives to box up everything that can be saved.',
    feel: 'Overwhelmed, displaced, unsure what they are agreeing to.',
    pain: 'Hard to see what is being taken, what is left behind, and why.',
    rec: 'A same-day walkthrough and a photo inventory the customer can see.' },
  { id: 'store', touch: 'Phone calls · insurance adjuster', n: '02', t: 'Store',
    doing: 'Belongings sit in Premier’s warehouse for weeks while the home is repaired.',
    feel: 'Out of sight, out of control.',
    pain: 'Long stretches with no word on where things are or how they are doing.',
    rec: 'Proactive updates at set milestones instead of waiting for the customer to call.' },
  { id: 'clean', touch: 'Restoration team · adjuster · non-salvageable list', n: '03', t: 'Clean',
    doing: 'Items are cleaned and restored, or written off for the insurance claim.',
    feel: 'Hopeful, then anxious about what can’t be saved.',
    pain: 'Learning late that a sentimental item couldn’t be restored.',
    rec: 'Explain restore-vs-replace calls, with photos, before they are final.' },
  { id: 'packback', touch: 'Coordinator · contractors · insurer', n: '04', t: 'Pack-back',
    doing: 'Scheduling the return once contractors finish and the claim allows it.',
    feel: 'Impatient to be home.',
    pain: 'Timing depends on contractors and the insurer, and no one owns the date.',
    rec: 'One coordinator owns the schedule end to end and confirms it in writing.' },
  { id: 'return', touch: 'Delivery crew · final walkthrough', n: '05', t: 'Return',
    doing: 'Items come back into the repaired home.',
    feel: 'Relief, and the first real sense that it’s over.',
    pain: 'Boxes dropped instead of placed, and missing items noticed days later.',
    rec: 'White-glove placement and a final checklist signed together.' },
];
// Hero journey line: the path's anchor points as % of its 1000x220 viewBox,
// so each stage label sits on its dot.
const heroPts = [[10, 62.7], [28, 31.8], [49, 71.8], [69, 37.3], [90, 54.5]];
// Section 05: the journey as it ran vs. the white-glove version, one row per stage.
const improvements = [
  { s: 'Pack', now: 'The inventory stays with the crew; the customer signs and hopes.', next: 'Walkthrough on the day, and a photo inventory the customer keeps.' },
  { s: 'Store', now: 'Status updates happen when the customer calls in.', next: 'Updates at set milestones, before the customer has to ask.' },
  { s: 'Clean', now: 'Bad news about unsalvageable items arrives late.', next: 'Restore-vs-replace calls explained with photos while they can still be discussed.' },
  { s: 'Pack-back', now: 'The return date floats between contractors and the insurer.', next: 'One coordinator owns the date and confirms it in writing.' },
  { s: 'Return', now: 'The job ends when the truck leaves.', next: 'Items placed room by room and a final checklist signed together.' },
];
// Section 09 overview table: the lenses, in reading order.
const lenses = [
  { k: 'doing', label: 'Customer is' },
  { k: 'feel', label: 'Feeling' },
  { k: 'touch', label: 'Touchpoints' },
  { k: 'pain', label: 'Pain point' },
  { k: 'rec', label: 'Recommendation' },
];
---
<Base
  accent="premier"
  title="Premier CX Analysis — Jack Motzkin"
  description="Case study (draft): mapping the customer journey of a fire & flood contents company with its CEO — pack-out, storage, cleaning, and pack-back — to shape a white-glove service."
>
  <Nav />
  <p class="mock-badge">Premier · mockup</p>
  <main>
    <!-- Hero (no photo yet: the five-stage journey line over an accent glow) -->
    <header class="case-hero" id="case-top">
      <div class="hero-map" aria-hidden="true">
        <svg viewBox="0 0 1000 220" preserveAspectRatio="none">
          <path class="hj-line" d="M20 144 C 50 141, 75 139, 100 138 C 170 132, 190 70, 280 70 C 370 70, 400 160, 490 158 C 580 156, 600 82, 690 82 C 780 82, 820 124, 900 120 C 940 118, 960 114, 980 112" vector-effect="non-scaling-stroke" />
        </svg>
        <ol>
          {stages.map((s, i) => (<li style={`left:${heroPts[i][0]}%;top:${heroPts[i][1]}%`}>{s.t}</li>))}
        </ol>
      </div>
      <div class="case-hero-in wrap">
        <a class="back" href="/#work">
          <svg width="16" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true"><path d="M17 6H2m0 0 5-5M2 6l5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          All work
        </a>
        <p class="case-eyebrow"><span class="idx">03</span><span class="rule"></span>Case study · CX Research</p>
        <h1 class="case-title" data-hero-name><span class="line"><span>Premier CX</span></span><span class="line"><span class="accent">Analysis</span></span></h1>
        <p class="case-lead">
          Partnering with the CEO of a fire &amp; flood contents company to map the customer journey
          and surface pain points across packing, storage, cleaning, and pack-back, then shape a white-glove service.
        </p>
      </div>
    </header>

    <div class="wrap">
      <div class="snapshot" data-reveal>
        <div class="snap-row"><span class="mono-label">My role</span><p>CX researcher, working directly with the CEO to map the end-to-end customer journey from the first call to the final pack-back. <span class="draft">[Add scope and timeframe.]</span></p></div>
        <div class="snap-row"><span class="mono-label">Outcome</span><p>A stage-by-stage journey map and a set of service recommendations for a white-glove experience. <span class="draft">[Confirm what was adopted.]</span> <a class="jump" href="#journey">See the journey ↓</a></p></div>
      </div>
      <dl class="case-meta" data-reveal>
        {meta.map((m) => (<div><dt>{m.k}</dt><dd>{m.v}</dd></div>))}
      </dl>
    </div>

    <div class="wrap">
      <!-- 02 Problem -->
      <section class="csec" id="problem">
        <div class="shead" data-reveal><span class="n">02</span><h2>Problem overview</h2></div>
        <div class="two">
          <div data-reveal>
            <p class="lead">When a fire or flood damages a home, Premier Packout packs out the family’s belongings, stores them, cleans and restores what can be saved, then packs everything back in.</p>
            <p class="body-p">Customers meet the company on one of the worst days of their lives, and the service runs for weeks across several crews and an insurance claim. Every handoff is a chance to lose their trust. <span class="draft">[Tighten with the CEO’s framing of the problem.]</span></p>
          </div>
          <div class="callout" data-reveal>Nobody chooses to need this service, so every handoff has to earn trust.</div>
        </div>
      </section>

      <!-- 03 Research -->
      <section class="csec" id="research">
        <div class="shead" data-reveal><span class="n">03</span><h2>Research approach</h2></div>
        <p class="lead" data-reveal>I worked alongside the CEO to see the service from the customer’s side, one stage at a time. <span class="draft">[Swap in your exact methods.]</span></p>
        <div class="cards" data-reveal>
          {research.map((c) => (
            <div class="card"><span class="k">{c.n}</span><div><h3>{c.t}</h3><p>{c.d}</p></div></div>
          ))}
        </div>
        <div class="slot slot-wide" data-reveal><span class="mono-label">Image slot</span>Research artifact: session notes, stakeholder map, or customer quotes</div>
      </section>

      <!-- 04 Recommendations (CX relabel of "Design decisions") -->
      <section class="csec" id="recommendations">
        <div class="shead" data-reveal><span class="n">04</span><h2>Recommendations</h2></div>
        <div class="two">
          <div data-reveal>
            <p class="lead">The pain points clustered around one theme: customers lose sight of their belongings, and of who is responsible for them. <span class="draft">[Confirm the themes.]</span></p>
            <ul class="rows">
              {recs.map((d) => (<li><span class="mono-label">{d.k}</span>{d.d}</li>))}
            </ul>
          </div>
          <div data-reveal>
            <div class="callout">White-glove isn’t a premium tier. It’s a service with no surprises in it.</div>
            <p class="body-p">Each recommendation answers one question a customer is left asking today: <em>what did you take, where is it, who do I call, what couldn’t you save, when do I get it back?</em></p>
          </div>
        </div>
      </section>

      <!-- 05 Service improvements (CX relabel of "Design format & iteration") -->
      <section class="csec" id="improvements">
        <div class="shead" data-reveal><span class="n">05</span><h2>Service improvements</h2></div>
        <p class="lead" data-reveal>From the journey as it ran to a white-glove version, stage by stage. <span class="draft">[Check each row against what you proposed.]</span></p>
        <div class="imp" data-reveal>
          <div class="imp-head" aria-hidden="true"><span></span><span>Today</span><span>White-glove</span></div>
          {improvements.map((r) => (
            <div class="imp-row">
              <span class="imp-s">{r.s}</span>
              <p class="imp-now"><span class="imp-lab">Today</span>{r.now}</p>
              <p class="imp-next"><span class="imp-lab">White-glove</span>{r.next}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- 06 Testing -->
      <section class="csec" id="testing">
        <div class="shead" data-reveal><span class="n">06</span><h2>Testing insights</h2></div>
        <div class="two">
          <div class="callout" data-reveal>Checked against the people who run the service every day.</div>
          <div data-reveal>
            <p class="body-p">I walked the proposed journey back through with the CEO and refined each stage against how the crews actually work. <span class="draft">[Add who validated it and the 2–3 changes it drove.]</span></p>
          </div>
        </div>
      </section>

      <!-- 07 Results -->
      <section class="csec" id="results">
        <div class="shead" data-reveal><span class="n">07</span><h2>Results</h2></div>
        <p class="lead" data-reveal>A shared map of the customer’s experience and a clear set of changes to make it white-glove. <span class="draft">[Add what changed after, in numbers or quotes.]</span></p>
        <div class="stats" data-reveal>
          <div class="stat"><div class="big">5</div><div class="statlab">Journey stages mapped, pack-out to return</div></div>
          <div class="stat"><div class="big draft-num">#</div><div class="statlab">Pain points surfaced <span class="draft">[count]</span></div></div>
          <div class="stat"><div class="big">1</div><div class="statlab">White-glove service blueprint for the CEO</div></div>
        </div>
        <blockquote class="quote" data-reveal>
          <p><span class="draft">[A line from the CEO, or one thing Premier changed because of this work.]</span></p>
          <cite class="mono-label">CEO, Premier Packout</cite>
        </blockquote>
      </section>

      <!-- 08 Reflection -->
      <section class="csec" id="reflection">
        <div class="shead" data-reveal><span class="n">08</span><h2>Reflection</h2></div>
        <div class="two">
          <div class="callout" data-reveal>What I’d carry forward, and do differently next time.</div>
          <div data-reveal>
            <p class="body-p">Working beside the CEO showed me how much of an experience lives outside any screen. Next time I’d speak with customers directly at each stage, not only through the people who serve them. <span class="draft">[Make it yours.]</span></p>
          </div>
        </div>
      </section>

      <!-- 09 Journey map & deliverable (CX relabel of the prototype section) -->
      <section class="csec" id="journey">
        <div class="shead" data-reveal><span class="n">09</span><h2>Journey map &amp; deliverable</h2></div>
        <p class="lead" data-reveal>Pick a stage to see what the customer is going through, where it breaks, and what I recommended. <span class="draft">[Stage details are placeholders until your map is in.]</span></p>
        <div class="journey" data-reveal>
          <div class="jstrip" role="tablist" aria-label="Customer journey stages">
            {stages.map((s, i) => (
              <button class="jstage" role="tab" type="button" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`}
                aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                <span class="jn">{s.n}</span><span class="jt">{s.t}</span>
              </button>
            ))}
          </div>
          {stages.map((s, i) => (
            <div class="jpanel" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} hidden={i !== 0}>
              <div><span class="mono-label">Customer is</span><p>{s.doing}</p></div>
              <div><span class="mono-label">Feeling</span><p>{s.feel}</p></div>
              <div><span class="mono-label">Touchpoints</span><p>{s.touch}</p></div>
              <div><span class="mono-label">Pain point</span><p>{s.pain} <span class="draft">[draft]</span></p></div>
              <div><span class="mono-label">Recommendation</span><p>{s.rec} <span class="draft">[draft]</span></p></div>
            </div>
          ))}
        </div>
        <h3 class="subhead" data-reveal>The whole map at a glance</h3>
        <div class="jm-scroll" tabindex="0" role="region" aria-labelledby="jm-cap" data-reveal>
          <table class="jm-table">
            <caption id="jm-cap" class="sr-only">Premier Packout customer journey: five stages by five lenses (scrolls sideways on small screens)</caption>
            <thead>
              <tr><td></td>{stages.map((s) => (<th scope="col"><span class="jn-s">{s.n}</span>{s.t}</th>))}</tr>
            </thead>
            <tbody>
              {lenses.map((l) => (
                <tr class={`jm-r-${l.k}`}>
                  <th scope="row">{l.label}</th>
                  {stages.map((s) => (<td>{s[l.k]}</td>))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="slot slot-wide" data-reveal><span class="mono-label">Image slot</span>The original journey map deliverable, as handed to the CEO</div>
      </section>
    </div>

    <section class="section pager-sec">
      <div class="wrap pager">
        <a class="pager-link" href="/#work">
          <span class="mono-label">Back</span>
          <span class="pager-t">All work</span>
        </a>
        <a class="pager-link next" href="/work/oxfam">
          <span class="mono-label">Next project</span>
          <span class="pager-t">Oxfam Support Redesign
            <svg width="18" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true"><path d="M1 6h15m0 0-5-5m5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  main{padding-top:0}

  .mock-badge{position:fixed;left:14px;bottom:14px;z-index:90;margin:0;padding:8px 12px;border-radius:8px;
    background:var(--gold);color:var(--bg);font-family:var(--mono);font-size:11px;font-weight:500;
    letter-spacing:.1em;text-transform:uppercase}

  /* Hero: no photo yet, so an accent glow sits over the site grid */
  .case-hero{position:relative;min-height:56vh;display:flex;align-items:flex-end;overflow:hidden;
    border-bottom:1px solid var(--line);
    background:radial-gradient(ellipse 70% 90% at 85% 10%,var(--gold-glow),transparent 70%)}
  /* Journey line in the hero's empty right half; the title owns the left */
  .hero-map{position:absolute;left:52%;right:max(4vw,24px);top:24%;height:40%;pointer-events:none}
  .hero-map svg{position:absolute;inset:0;width:100%;height:100%;opacity:.7}
  .hj-line{fill:none;stroke:var(--gold);stroke-width:2;stroke-dasharray:6 8}
  .hero-map ol{position:absolute;inset:0;list-style:none;margin:0;padding:0}
  .hero-map li{position:absolute;transform:translate(-50%,-7px);display:flex;flex-direction:column;align-items:center;gap:10px;
    font-family:var(--mono);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted-fg)}
  .hero-map li::before{content:"";width:14px;height:14px;border-radius:50%;background:var(--bg);border:2.5px solid var(--gold-soft)}
  @media (max-width:1000px){.hero-map{display:none}}
  .case-hero-in{position:relative;z-index:2;width:100%;padding:120px var(--pad) clamp(30px,4vw,52px)}
  .back{display:inline-flex;align-items:center;gap:9px;font-family:var(--mono);font-size:12px;
    letter-spacing:.12em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:22px;transition:color .2s}
  .back:hover{color:var(--gold)}
  .case-eyebrow{display:flex;align-items:center;gap:14px;font-family:var(--mono);font-size:12.5px;
    letter-spacing:.2em;text-transform:uppercase;color:var(--gold-soft);margin-bottom:16px}
  .case-eyebrow .idx{font-family:var(--display);font-weight:700;color:var(--ink);font-size:14px}
  .case-eyebrow .rule{height:1px;width:min(90px,14vw);background:var(--gold-soft);opacity:.6}
  .case-title{font-size:clamp(2.5rem,8vw,5.6rem);text-transform:uppercase;letter-spacing:-.03em;line-height:.88}
  .case-title .line{display:block}
  .case-title .accent{color:var(--gold-soft)}
  .case-lead{max-width:58ch;margin-top:20px;font-size:clamp(1.05rem,1.8vw,1.3rem);line-height:1.6;color:var(--ink)}

  /* Snapshot + meta */
  .snapshot{margin:36px 0 0;display:flex;flex-direction:column;gap:14px;padding:22px 24px;
    border:1px solid var(--line);border-left:2px solid var(--gold);border-radius:var(--radius);
    background:color-mix(in srgb,var(--gold) 6%,var(--panel))}
  .snap-row{display:grid;grid-template-columns:96px 1fr;gap:16px;align-items:baseline}
  .snap-row .mono-label{color:var(--gold)}
  .snap-row p{color:var(--ink);font-size:1.02rem;line-height:1.55}
  .jump{color:var(--gold);font-family:var(--mono);font-size:12px;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap}
  .jump:hover{text-decoration:underline}
  @media (max-width:560px){.snap-row{grid-template-columns:1fr;gap:4px}}
  .case-meta{display:grid;grid-template-columns:repeat(4,auto);gap:14px 44px;margin:26px 0 0;
    padding-top:22px;border-top:1px solid var(--line)}
  .case-meta div{display:flex;flex-direction:column;gap:5px}
  .case-meta dt{font-family:var(--mono);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted-fg)}
  .case-meta dd{margin:0;font-family:var(--display);font-weight:500;font-size:1.05rem}
  @media (max-width:640px){.case-meta{grid-template-columns:1fr 1fr}}

  /* Sections */
  .csec{padding:clamp(44px,6vw,84px) 0;position:relative}
  .shead{display:flex;align-items:baseline;gap:16px;margin-bottom:24px}
  .shead .n{font-family:var(--mono);color:var(--gold);font-size:13px;font-weight:500}
  .shead h2{font-size:clamp(1.6rem,4vw,2.6rem);text-transform:uppercase}
  #results .shead h2{color:var(--gold)}
  .lead{color:var(--ink-soft);max-width:62ch;font-size:1.08rem}
  .two{display:grid;grid-template-columns:1fr 1fr;gap:clamp(26px,4vw,52px);align-items:start;margin-top:12px}
  .two > *{min-width:0}
  @media (max-width:820px){.two{grid-template-columns:1fr;gap:26px}}
  .body-p{color:var(--ink-soft);max-width:58ch;margin-top:14px}
  .draft{color:var(--gold)}
  .callout{border-left:2px solid var(--gold);padding-left:22px;font-family:var(--display);font-weight:500;
    font-size:clamp(1.2rem,2.4vw,1.7rem);line-height:1.3;color:var(--ink);max-width:26ch}

  /* Image slots: where Jack's real artifacts go */
  figure{margin:0}
  .slot{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;text-align:center;
    min-height:220px;padding:24px;border:1px dashed var(--line-2);border-radius:var(--radius);
    background:repeating-linear-gradient(135deg,transparent 0 14px,color-mix(in srgb,var(--gold) 5%,transparent) 14px 15px);
    color:var(--ink-soft);font-size:14px}
  .slot .mono-label{color:var(--gold)}
  .slot-wide{margin-top:22px;min-height:260px}
  .cap{font-family:var(--mono);font-size:11.5px;letter-spacing:.04em;color:var(--muted-fg);margin-top:10px}
  .cap b{color:var(--gold);font-weight:500}

  /* Research cards */
  .cards{display:grid;grid-template-columns:1fr 1fr;gap:2px;border:1px solid var(--line);border-radius:var(--radius);
    overflow:hidden;background:var(--line);margin-top:16px}
  @media (max-width:760px){.cards{grid-template-columns:1fr}}
  .card{background:var(--bg);padding:22px;display:flex;gap:16px;align-items:flex-start}
  .card .k{font-family:var(--display);font-weight:700;color:var(--gold);font-size:1.05rem;min-width:2ch}
  .card h3{font-size:1.1rem;margin-bottom:6px}
  .card p{color:var(--ink-soft);font-size:14px;line-height:1.6}

  /* Recommendation rows */
  .rows{list-style:none;margin:16px 0 0;padding:0;border-top:1px solid var(--line)}
  .rows li{display:grid;grid-template-columns:120px 1fr;gap:16px;padding:13px 0;border-bottom:1px solid var(--line);
    align-items:baseline;color:var(--ink)}
  .rows .mono-label{color:var(--gold)}
  @media (max-width:480px){.rows li{grid-template-columns:1fr;gap:4px}}

  /* Service improvements: today vs white-glove */
  .imp{margin-top:18px;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}
  .imp-head,.imp-row{display:grid;grid-template-columns:130px 1fr 1fr}
  .imp-head span{padding:12px 18px;font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;
    color:var(--muted-fg);border-bottom:1px solid var(--line)}
  .imp-head span:last-child{color:var(--gold)}
  .imp-row + .imp-row{border-top:1px solid var(--line)}
  .imp-s{padding:18px;font-family:var(--display);font-weight:600;color:var(--ink)}
  .imp-now,.imp-next{padding:18px;font-size:14.5px;line-height:1.55}
  .imp-now{color:var(--ink-soft)}
  .imp-next{color:var(--ink);background:color-mix(in srgb,var(--gold) 7%,transparent);border-left:2px solid var(--gold)}
  .imp-lab{display:none}
  @media (max-width:720px){
    .imp-head{display:none}
    .imp-row{grid-template-columns:1fr}
    .imp-s{padding-bottom:0}
    .imp-now,.imp-next{padding-top:10px}
    .imp-lab{display:block;font-family:var(--mono);font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;
      color:var(--muted-fg);margin-bottom:4px}
