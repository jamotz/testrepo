<script>
  // Journey panel: roving-tabindex phase tabs (click, or arrow keys / Home / End), kept in
  // step with the sentiment line above them
  (function () {
    const tabs = [...document.querySelectorAll('.jstage')];
    if (!tabs.length) return;
    function select(i, focus) {
      tabs.forEach((t, j) => {
        const on = j === i;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
      });
      document.querySelectorAll('.jline [data-phase]').forEach((el) => {
        el.classList.toggle('on', Number(el.dataset.phase) === i);
      });
      if (focus) tabs[i].focus();
    }
    // the sentiment line: click a point, or anywhere in a phase's column, to open that phase
    document.querySelectorAll('.jline [data-phase]').forEach((el) => {
      el.addEventListener('click', () => select(Number(el.dataset.phase)));
    });
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const k = e.key;
        let n = null;
        if (k === 'ArrowRight' || k === 'ArrowDown') n = (i + 1) % tabs.length;
        else if (k === 'ArrowLeft' || k === 'ArrowUp') n = (i - 1 + tabs.length) % tabs.length;
        else if (k === 'Home') n = 0;
        else if (k === 'End') n = tabs.length - 1;
        if (n !== null) { e.preventDefault(); select(n, true); }
      });
    });
  })();
</script>
