---
import "../styles/global.css";
const {
  title = "MOTZ — Jack Motzkin · UX Researcher & Designer",
  description = "Jack Motzkin (MOTZ) is a UX researcher & designer who leads with psychology, evidence, and accessibility — turning how people behave into intuitive, inclusive experiences.",
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#7C5CFF" />
    <link rel="icon" type="image/svg+xml" href="/brand/logo-black.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/brand/logo-white.svg" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" href="/brand/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/brand/apple-touch.png" />
    <link rel="preload" href="/fonts/jetbrains-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plexsans-400.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <!-- No-flash theme: run before first paint -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("motz-theme");
          if (t === "light" || t === "dark")
            document.documentElement.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#work">Skip to content</a>
    <div class="cursor" aria-hidden="true"></div>
    <div class="cursor-ring" aria-hidden="true"></div>
    <div class="coords" aria-hidden="true"></div>
    <slot />
    <script>
      import "../scripts/main.js";
    </script>
  </body>
</html>
