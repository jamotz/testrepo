---
const items = [
  {
    title: "Research-led",
    body: "Interviews, journey maps, and usability testing come before a single pixel — decisions grounded in evidence, not assumptions.",
    icon: `<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/>`,
  },
  {
    title: "Human at heart",
    body: "A psychology degree and sociology minor mean I read behavior, motivation, and emotion — not just clicks and funnels.",
    icon: `<path d="M12 21s-7-4.35-9.5-8.5C.5 9 2.5 5 6 5c2 0 3.2 1.2 4 2.5C10.8 6.2 12 5 14 5c3.5 0 5.5 4 3.5 7.5C19 16.65 12 21 12 21z"/>`,
  },
  {
    title: "Accessible always",
    body: "Inspired by a grandmother with macular degeneration, inclusive design is personal — everyone deserves to belong online.",
    icon: `<circle cx="12" cy="4" r="1.6"/><path d="M5 8h14M12 8v6M12 14l-3 6M12 14l3 6"/>`,
  },
];
---
<section class="section">
  <div class="wrap">
    <div class="ethos">
      {items.map((it, i) => (
        <article class="ecard reveal" data-delay={i * 80}>
          <span class="ic" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={it.icon}></svg>
          </span>
          <h3>{it.title}</h3>
          <p>{it.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
