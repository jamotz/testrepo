---
import Logo from "./Logo.astro";
---
<header class="nav">
  <div class="wrap row">
    <a class="brand" href="#top" aria-label="MOTZ — home">
      <Logo />
      <span class="wordmark">MOTZ</span>
    </a>
    <nav class="nav-links" aria-label="Primary">
      <a class="link" href="#work">Work</a>
      <a class="link" href="#about">About</a>
      <a class="link" href="#contact">Contact</a>
      <button class="theme-toggle" type="button" aria-label="Toggle dark mode">
        <svg class="moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a class="btn btn-primary" href="#contact">Let's talk</a>
    </nav>
  </div>
</header>
