---
import Logo from './Logo.astro';
const links = [
  { href: '#work', label: 'Work' },
  { href: '#about', label: 'About' },
  { href: '#contact', label: 'Contact' },
];
---
<header class="nav" data-nav>
  <div class="wrap nav-inner">
    <a class="brand" href="#top" aria-label="Jack Motzkin — home">
      <span class="brand-mark"><Logo /></span>
      <span class="brand-word">MOTZ</span>
    </a>
    <nav class="nav-links" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a class="btn btn-primary nav-cta" href="#contact">Get in touch</a>
    </nav>
    <button class="nav-toggle" data-nav-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
      <span></span><span></span>
    </button>
  </div>
</header>
<!-- Outside <header> on purpose: the nav's backdrop-filter would otherwise
     become the containing block for this fixed panel. -->
<div class="mobile-menu" id="mobile-menu" data-mobile-menu>
  <nav aria-label="Mobile">
    {links.map((l) => <a class="mlink" href={l.href} data-mobile-link>{l.label}</a>)}
    <a class="btn btn-primary mcta" href="#contact" data-mobile-link>Get in touch</a>
  </nav>
</div>

<style>
  .nav{position:fixed;top:0;left:0;right:0;z-index:100;
    transition:background-color .3s ease,border-color .3s ease,backdrop-filter .3s ease;
    border-bottom:1px solid transparent}
  .nav[data-scrolled]{background:color-mix(in srgb,var(--bg) 78%,transparent);
    backdrop-filter:blur(12px);border-bottom-color:var(--line)}
  .nav-inner{display:flex;align-items:center;justify-content:space-between;height:74px}
  .brand{display:flex;align-items:center;gap:11px;color:var(--ink)}
  .brand-mark{display:block;width:30px;height:30px;color:var(--ink);transition:transform .5s var(--ease-out)}
  .brand:hover .brand-mark{transform:rotate(-12deg)}
  .brand-word{font-family:var(--display);font-weight:700;font-size:19px;letter-spacing:.04em}

  .nav-links{display:flex;align-items:center;gap:8px}
  .nav-links > a:not(.nav-cta){font-family:var(--mono);font-size:12.5px;letter-spacing:.1em;
    text-transform:uppercase;color:var(--ink-soft);padding:9px 14px;border-radius:8px;transition:color .2s,background-color .2s}
  .nav-links > a:not(.nav-cta):hover{color:var(--ink);background:rgba(255,255,255,.04)}
  .nav-cta{margin-left:8px;padding:11px 18px;font-size:13.5px}

  .nav-toggle{display:none;flex-direction:column;justify-content:center;align-items:center;gap:6px;
    width:44px;height:44px;background:transparent;border:1px solid var(--line-2);border-radius:10px}
  .nav-toggle span{width:20px;height:2px;background:var(--ink);transition:transform .3s var(--ease-out),opacity .3s}
  .nav[data-menu-open] .nav-toggle span:first-child{transform:translateY(4px) rotate(45deg)}
  .nav[data-menu-open] .nav-toggle span:last-child{transform:translateY(-4px) rotate(-45deg)}

  .mobile-menu{display:none}

  @media (max-width:760px){
    .nav-links{display:none}
    .nav-toggle{display:flex}
    .mobile-menu{display:block;position:fixed;inset:74px 0 0;z-index:99;
      background:var(--bg);border-top:1px solid var(--line);
      padding:24px var(--pad);transform:translateY(-8px);opacity:0;visibility:hidden;pointer-events:none;
      transition:opacity .3s var(--ease-out),transform .3s var(--ease-out),visibility .3s}
    .mobile-menu[data-open]{opacity:1;visibility:visible;transform:none;pointer-events:auto}
    .mobile-menu nav{display:flex;flex-direction:column;gap:4px}
    .mobile-menu .mlink{font-family:var(--display);font-weight:700;font-size:1.7rem;
      text-transform:uppercase;letter-spacing:-.01em;padding:16px 0;border-bottom:1px solid var(--line);color:var(--ink)}
    .mobile-menu .mcta{margin-top:20px;justify-content:center;font-size:1rem}
  }
</style>
