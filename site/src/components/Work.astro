---
const projects = [
  {
    num: "01", ac: "var(--oxfam)", code: "OXFAM", role: "UX Research & Design", client: "Oxfam Australia", loc: "Melbourne, AU",
    title: "Oxfam Support Redesign",
    body: "Restructured Oxfam Australia's support pages and the MyOxfam portal — new information architecture, wireframes, usability testing, and a final design presented to stakeholders.",
  },
  {
    num: "02", ac: "var(--origins)", code: "ORIGINS", role: "UX Researcher & Designer", client: "Origins Cannabis", loc: "Redmond, WA",
    title: "Origins App Redesign",
    body: "Interviewed real dispensary customers in person to learn why the app failed them, then rebuilt the product display and information architecture — validated through hands-on usability testing.",
  },
  {
    num: "03", ac: "var(--premier)", code: "PREMIER", role: "CX Researcher", client: "Premier Packout", loc: "Scottsdale, AZ",
    title: "Premier CX Analysis",
    body: "Partnered with the CEO to map the customer journey of a fire & flood contents company — surfacing pain points across packing, storage, cleaning, and pack-back to deliver a white-glove service.",
  },
];
---
<section class="section" id="work">
  <div class="wrap shell">
    <aside class="spine reveal">
      <span class="idx">01</span>
      <span class="slabel">Selected Work</span>
    </aside>
    <div class="content">
      <div class="head reveal">
        <span class="label">// three clients, three worlds</span>
        <h2>Selected work</h2>
        <p>Every project meant meeting real people where they were — from a Melbourne charity to an Arizona pack-out crew.</p>
      </div>
      <div class="work-list">
        {projects.map((p, i) => (
          <a class="proj reveal" href="#contact" style={`--ac:${p.ac}`} data-delay={i * 60} aria-label={`${p.title} — case study`}>
            <span class="num">{p.num}</span>
            <div class="info">
              <h3>{p.title}</h3>
              <div class="meta">
                <span class="m"><b>role</b> {p.role}</span>
                <span class="m"><b>client</b> {p.client}</span>
                <span class="m"><b>loc</b> {p.loc}</span>
              </div>
              <p>{p.body}</p>
              <span class="go">View study
                <svg width="16" height="11" viewBox="0 0 18 12" fill="none" aria-hidden="true"><path d="M1 6h15m0 0-5-5m5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </div>
            <div class="art" aria-hidden="true">
              <canvas></canvas>
              <span class="code">{p.code}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
