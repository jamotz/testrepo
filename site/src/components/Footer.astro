---
import Logo from "./Logo.astro";
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap row">
    <a class="brand" href="#top" aria-label="MOTZ — home">
      <Logo />
      <span class="wordmark">MOTZ</span>
    </a>
    <span class="meta">© {year} Jack Motzkin — UX Researcher &amp; Designer</span>
    <div class="social">
      <a href="mailto:hello@jackmotzkin.com" aria-label="Email">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
      </a>
      <a href="https://www.linkedin.com/" aria-label="LinkedIn" rel="noopener" target="_blank">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v6h-4v-6a2 2 0 0 0-4 0v6h-4v-10h4v1.5"/><rect x="2" y="9" width="4" height="11"/><circle cx="4" cy="4" r="2"/></svg>
      </a>
    </div>
  </div>
</footer>
