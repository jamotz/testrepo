---
import Logo from './Logo.astro';
const year = new Date().getFullYear();
const home = Astro.url.pathname === '/';
const base = home ? '' : '/';
---
<footer class="footer">
  <div class="wrap footer-inner">
    <a class="footer-brand" href={home ? '#top' : '/'} aria-label="Back to top">
      <span class="footer-mark"><Logo /></span>
      <span>Jack Motzkin</span>
    </a>
    <p class="footer-tag">UX Researcher &amp; Designer · Southwest, USA</p>
    <nav class="footer-links" aria-label="Footer">
      <a href={`${base}#work`}>Work</a>
      <a href={`${base}#about`}>About</a>
      <a href={`${base}#contact`}>Contact</a>
    </nav>
    <p class="footer-copy mono-label">© {year} Jack Motzkin</p>
  </div>
</footer>

<style>
  .footer{border-top:1px solid var(--line);padding:40px 0}
  .footer-inner{display:flex;align-items:center;justify-content:space-between;gap:20px 32px;flex-wrap:wrap}
  .footer-brand{display:flex;align-items:center;gap:11px;color:var(--ink);font-family:var(--display);font-weight:700}
  .footer-mark{display:block;width:26px;height:26px;color:var(--ink)}
  .footer-tag{color:var(--muted-fg);font-size:13.5px}
  .footer-links{display:flex;gap:20px}
  .footer-links a{font-family:var(--mono);font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft)}
  .footer-links a:hover{color:var(--gold)}
  .footer-copy{color:var(--muted-fg)}
  @media (max-width:600px){.footer-inner{flex-direction:column;align-items:flex-start}}
</style>
