---
import ProfileLinks from './ProfileLinks.astro';
import { EMAIL } from '../data/site.js';
---
<section class="section contact" id="contact">
  <div class="wrap">
    <div class="contact-head">
      <p class="eyebrow" data-reveal>04 — Contact</p>
      <h2 data-reveal>Let’s talk about<br /><span class="grad">your users.</span></h2>
      <p class="contact-lede" data-reveal>
        Hiring for UX research or design, or have a project in mind? Email is the quickest way
        to reach me.
      </p>
    </div>

    <div class="contact-card" data-reveal>
      <div class="contact-direct">
        <span class="mono-label">Email</span>
        <div class="email-row">
          <a class="contact-email" href={`mailto:${EMAIL}`}>{EMAIL}</a>
          <button class="btn btn-ghost copy-btn" type="button" data-copy={EMAIL}>
            <svg class="i-copy" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/></svg>
            <svg class="i-done" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5 10 17 19 7"/></svg>
            <span data-copy-label>Copy</span>
          </button>
        </div>
        <p class="sr-only" role="status" aria-live="polite" data-copy-status></p>
      </div>

      <div class="contact-foot">
        <ProfileLinks />
        <p class="contact-avail"><span class="dot"></span>Open to UX research and design roles</p>
      </div>
    </div>
  </div>
</section>

<script>
  // Copy the address; fall back to selecting it when the Clipboard API is unavailable
  // (older browsers, or a sandboxed frame without clipboard permission).
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.querySelector('[data-copy-label]');
    const status = btn.closest('.contact-direct')?.querySelector('[data-copy-status]');
    let timer = 0;
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy || '';
      let ok = false;
      try { await navigator.clipboard.writeText(text); ok = true; } catch {
        const a = btn.parentElement?.querySelector('.contact-email');
        if (a) { const r = document.createRange(); r.selectNodeContents(a); const s = getSelection(); s?.removeAllRanges(); s?.addRange(r); }
        try { ok = document.execCommand('copy'); } catch { ok = false; }
      }
      btn.toggleAttribute('data-copied', ok);
      if (label) label.textContent = ok ? 'Copied' : 'Press ⌘C / Ctrl+C';
      if (status) status.textContent = ok ? 'Email address copied to clipboard' : 'Email address selected';
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        btn.removeAttribute('data-copied');
        if (label) label.textContent = 'Copy';
        if (status) status.textContent = '';
      }, 2200);
    });
  });
</script>

<style>
  .contact-head{max-width:760px;margin-bottom:clamp(36px,5vw,56px)}
  .contact-head h2{font-size:clamp(2.6rem,8vw,5.5rem);text-transform:uppercase;margin:16px 0 20px}
  .contact-head .grad{background:linear-gradient(96deg,var(--gold),var(--gold-soft) 55%,var(--acid));
    -webkit-background-clip:text;background-clip:text;color:transparent}
  .contact-lede{color:var(--ink-soft);max-width:46ch;font-size:1.1rem}

  .contact-card{display:flex;flex-direction:column;gap:28px;padding:clamp(22px,4vw,36px);
    background:linear-gradient(180deg,var(--panel),var(--bg-2));border:1px solid var(--line);
    border-radius:var(--radius)}
  .contact-direct{display:flex;flex-direction:column;gap:12px}
  .email-row{display:flex;align-items:center;flex-wrap:wrap;gap:14px 20px}
  .contact-email{font-family:var(--display);font-weight:700;font-size:clamp(1.35rem,4.2vw,2.6rem);
    letter-spacing:-.01em;color:var(--ink);overflow-wrap:anywhere;transition:color .2s}
  .contact-email:hover{color:var(--gold)}
  .copy-btn{gap:8px;padding:11px 16px;font-size:14px;cursor:pointer}
  .copy-btn:hover svg{transform:none}
  .copy-btn .i-done{display:none}
  .copy-btn[data-copied]{border-color:var(--acid);color:var(--acid)}
  .copy-btn[data-copied] .i-copy{display:none}
  .copy-btn[data-copied] .i-done{display:block}

  .contact-foot{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:18px 28px;
    padding-top:24px;border-top:1px solid var(--line)}
  .contact-avail{display:flex;align-items:center;gap:10px;margin:0;color:var(--ink-soft);font-size:14.5px}
  .contact-avail .dot{flex:none;width:9px;height:9px;border-radius:50%;
    background:var(--acid);box-shadow:0 0 10px var(--acid)}
</style>
