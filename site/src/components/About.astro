---
const chips = ["BCS UX Certified", "IBM Data Science", "PeakXD Program", "Psychology & Sociology", "Eagle Scout"];
---
<section class="section" id="about">
  <div class="wrap about-grid">
    <div class="reveal">
      <span class="eyebrow">About Jack</span>
      <h2>From understanding people to designing for them.</h2>
      <p>
        I'm an Eagle Scout with a Bachelor's in Psychology and a minor in Sociology.
        In my senior year I pointed that human-behavior foundation at UX, completed an
        international research &amp; design program, and earned my <b>BCS UX</b> and
        <b>IBM Data Science</b> certifications.
      </p>
      <p>
        I want to help companies create intuitive, integrated, and accessible
        experiences — digital and physical — by truly understanding customers'
        behaviors, preferences, and needs.
      </p>
      <div class="chips">
        {chips.map((c) => <span>{c}</span>)}
      </div>
    </div>
    <figure class="quote reveal" data-delay="100">
      <span class="mk" aria-hidden="true">&ldquo;</span>
      <blockquote>
        To design for someone, you have to
        <span class="hl">walk in their shoes</span> — understand how they live,
        what they prefer, and what they need.
      </blockquote>
      <cite>— My approach to every project</cite>
    </figure>
  </div>
</section>
