---
import ProfileLinks from './ProfileLinks.astro';
import AboutCard from './AboutCard.astro';
// The short version for the landing page. The full story (background, why research,
// accessibility, work, life outside UX) lives on /about. Keep this column about as
// tall as the photo and profile card beside it.
---
<section class="section about" id="about">
  <div class="wrap about-grid">
    <div class="about-lead">
      <p class="eyebrow" data-reveal>03 — About</p>
      <h2 data-reveal>Behavior is the <span class="accent">interface.</span></h2>

      <div class="about-block" data-reveal>
        <h3 class="mono-label">Background</h3>
        <p>
          I’m Jack Motzkin. I live in the Southwest, I’m an Eagle Scout, and I have a B.A. in
          Psychology with a minor in Sociology. In my senior year I decided to apply that
          background to user experience. After graduating I completed PeakXD’s international UX
          research and design program and earned my BCS certificate in UX and the IBM Data
          Science certificate.
        </p>
      </div>

      <div class="about-block" data-reveal>
        <h3 class="mono-label">My work so far</h3>
        <p>
          I’ve done research for a charity in Australia, a dispensary in Washington and a
          pack-out company in Arizona. At Veeam I do the same kind of work with employees,
          using surveys to find out what isn’t working in the office and changing it.
        </p>
      </div>

      <div class="about-block about-goal" data-reveal>
        <h3 class="mono-label">What I’m looking for</h3>
        <p>
          A UX research role on a team that builds with its users, not around them. I want to
          go deep on research first and grow into design from there.
        </p>
      </div>

      <div class="about-actions" data-reveal>
        <a class="btn btn-primary" href="/about">
          More about me
          <svg width="18" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true"><path d="M1 6h15m0 0-5-5m5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <ProfileLinks />
      </div>
    </div>

    <AboutCard />
  </div>
</section>

<style>
  .about-grid{display:grid;grid-template-columns:1.3fr .95fr;gap:clamp(32px,5vw,64px);align-items:start}
  @media (max-width:900px){.about-grid{grid-template-columns:1fr;gap:36px}}

  .about-lead h2{font-size:clamp(2.2rem,6vw,4rem);text-transform:uppercase;margin:18px 0 34px}
  .about-lead h2 .accent{color:var(--gold)}
  .about-block{max-width:58ch;margin-bottom:28px}
  .about-block h3{margin:0 0 10px;color:var(--gold)}
  .about-block p{color:var(--ink-soft);font-size:1.05rem;line-height:1.7;margin:0 0 12px}
  .about-goal{padding:20px 22px;border:1px solid var(--line);border-left:2px solid var(--gold);
    border-radius:0 var(--radius) var(--radius) 0;background:color-mix(in srgb,var(--gold) 5%,transparent)}
  .about-goal p{color:var(--ink);margin:0}
  .about-actions{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
  .about-actions .btn-primary{padding:11px 18px;font-size:14px}
</style>
