---
import ProfileLinks from './ProfileLinks.astro';
// Credentials live in the profile card only; the copy beside it tells the story
// without listing them again.
const spec = [
  { k: 'Based', v: 'Southwest, USA' },
  { k: 'Education', v: 'B.A. Psychology · Sociology minor' },
  { k: 'Training', v: 'PeakXD UX Research & Design' },
  { k: 'Certified', v: 'BCS UX · IBM Data Science' },
  { k: 'Also', v: 'Eagle Scout' },
  { k: 'Status', v: 'Open to work', live: true },
];
---
<section class="section about" id="about">
  <div class="wrap about-grid">
    <div class="about-lead">
      <p class="eyebrow" data-reveal>03 — About</p>
      <h2 data-reveal>Behavior is the <span class="accent">interface.</span></h2>

      <div class="about-block" data-reveal>
        <h3 class="mono-label">Background</h3>
        <p>
          I’m Jack. I studied psychology and sociology, and by my senior year I’d noticed that
          the questions I cared about (why people do what they do, and what gets in their way)
          are the same ones a good product has to answer. So after graduating I trained in UX
          research and design and started working with real clients.
        </p>
      </div>

      <div class="about-block" data-reveal>
        <h3 class="mono-label">How I work</h3>
        <p>
          I start with people, not screens: interviews, surveys, card sorts, journey maps and
          usability tests. The evidence decides what gets designed, whether that’s a support
          site, an app’s filters, or a service that happens mostly in person.
        </p>
        <p>
          Accessibility matters to me personally. My grandmother has macular degeneration, so
          I’ve seen how quickly the web gets harder when a design assumes perfect eyesight, and
          I design with that in mind.
        </p>
      </div>

      <div class="about-block about-goal" data-reveal>
        <h3 class="mono-label">What I’m looking for</h3>
        <p>
          A UX research role, or a research-heavy design role, on a team that builds with its
          users instead of guessing about them. I want to go deep on research first and grow
          into design from there, helping companies make digital and in-person experiences that
          are intuitive, connected and accessible.
        </p>
      </div>

      <div data-reveal><ProfileLinks /></div>
    </div>

    <aside class="about-side" data-reveal aria-label="Profile">
      <figure class="about-photo">
        <img src="/about/jack.jpg" alt="Jack standing in St. Peter’s Square beneath the colonnade" width="500" height="470" loading="lazy" decoding="async" />
      </figure>
      <div class="about-spec">
        <div class="spec-head">
          <span class="mono-label">profile.json</span>
          <span class="spec-dots"><i></i><i></i><i></i></span>
        </div>
        <dl class="spec-list">
          {spec.map((s) => (
            <div class="spec-row">
              <dt>{s.k}</dt>
              <dd class={s.live ? 'live' : ''}>{s.live && <span class="dot"></span>}{s.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </aside>
  </div>
</section>

<style>
  .about-grid{display:grid;grid-template-columns:1.3fr .95fr;gap:clamp(32px,5vw,64px);align-items:start}
  @media (max-width:900px){.about-grid{grid-template-columns:1fr;gap:36px}}

  .about-lead h2{font-size:clamp(2.2rem,6vw,4rem);text-transform:uppercase;margin:18px 0 34px}
  .about-lead h2 .accent{color:var(--gold)}
  .about-block{max-width:58ch;margin-bottom:28px}
  .about-block h3{margin:0 0 10px;color:var(--gold)}
  .about-block p{color:var(--ink-soft);font-size:1.05rem;line-height:1.7;margin:0 0 12px}
  .about-goal{padding:20px 22px;border:1px solid var(--line);border-left:2px solid var(--gold);
    border-radius:0 var(--radius) var(--radius) 0;background:color-mix(in srgb,var(--gold) 5%,transparent)}
  .about-goal p{color:var(--ink);margin:0}

  .about-side{position:sticky;top:100px;display:flex;flex-direction:column;gap:18px}
  @media (max-width:900px){.about-side{position:static}}
  .about-photo{margin:0;border-radius:var(--radius);overflow:hidden;border:1px solid var(--line);aspect-ratio:5/4}
  .about-photo img{width:100%;height:100%;object-fit:cover;object-position:50% 70%;display:block}

  .about-spec{background:linear-gradient(180deg,var(--panel),var(--bg-2));
    border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}
  .spec-head{display:flex;align-items:center;justify-content:space-between;padding:14px 18px;
    border-bottom:1px solid var(--line)}
  .spec-dots{display:flex;gap:6px}
  .spec-dots i{width:9px;height:9px;border-radius:50%;background:var(--line-3)}
  .spec-dots i:first-child{background:var(--gold)}
  .spec-dots i:nth-child(2){background:var(--acid)}
  .spec-list{margin:0;padding:8px 18px}
  .spec-row{display:grid;grid-template-columns:1fr 1.7fr;gap:14px;padding:12px 0;
    border-bottom:1px solid var(--line)}
  .spec-row:last-child{border-bottom:none}
  .spec-row dt{font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;
    color:var(--muted-fg);margin:0}
  .spec-row dd{margin:0;font-size:14.5px;color:var(--ink)}
  .spec-row dd.live{display:inline-flex;align-items:center;gap:8px;color:var(--acid)}
  .spec-row dd .dot{width:7px;height:7px;border-radius:50%;background:var(--acid);
    box-shadow:0 0 8px var(--acid)}
</style>
