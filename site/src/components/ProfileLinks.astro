---
// LinkedIn + résumé buttons, shared by About and Contact. Résumé links switch on
// automatically once RESUME.pdf / RESUME.web are set in data/site.js.
import { LINKEDIN, RESUME } from '../data/site.js';
---
<div class="plinks">
  <a class="btn btn-ghost plink" href={LINKEDIN} target="_blank" rel="noopener">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
    LinkedIn
    <span class="sr-only">(opens in a new tab)</span>
  </a>
  {RESUME.web && <a class="btn btn-ghost plink" href={RESUME.web}>View résumé</a>}
  {RESUME.pdf && (
    <a class="btn btn-ghost plink" href={RESUME.pdf} download>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 2v8m0 0-3.5-3.5M8 10l3.5-3.5M2.5 13.5h11" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Résumé (PDF)
    </a>
  )}
  {!RESUME.web && !RESUME.pdf && (
    <span class="btn btn-ghost plink is-soon" aria-disabled="true">Résumé <span class="soon">Coming soon</span></span>
  )}
</div>

<style>
  .plinks{display:flex;flex-wrap:wrap;gap:10px}
  .plink{gap:9px;padding:11px 16px;font-size:14px}
  .plink:hover svg{transform:none}
  .plink.is-soon{cursor:default;color:var(--muted-fg);border-style:dashed}
  .plink.is-soon:hover{transform:none;border-color:var(--line-2);color:var(--muted-fg);background:transparent}
  .plink .soon{font-family:var(--mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase}
</style>
