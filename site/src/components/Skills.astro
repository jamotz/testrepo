---
// Skills, right under the project cards so recruiters reach them without scrolling
// past About. The groups and wording live in data/site.js (SKILLS).
import { SKILLS } from '../data/site.js';
---
<div class="skills" id="skills" data-reveal>
  <h3 class="mono-label skills-title">Skills</h3>
  <div class="skills-grid">
    {SKILLS.map((g) => (
      <div class="skill-group">
        <h4 class="skill-head">{g.group}</h4>
        <ul class="skill-list">{g.items.map((s) => <li>{s}</li>)}</ul>
      </div>
    ))}
  </div>
</div>

<style>
  .skills{margin-top:clamp(40px,6vw,64px);padding-top:clamp(28px,4vw,40px);border-top:1px solid var(--line)}
  .skills-title{margin:0 0 22px;color:var(--gold)}
  /* the two short groups size to their longest chip, so no chip breaks onto two lines */
  .skills-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr) max-content max-content;gap:28px clamp(20px,3vw,40px)}
  @media (max-width:1100px){.skills-grid{grid-template-columns:1fr 1fr}}
  @media (max-width:560px){.skills-grid{grid-template-columns:1fr}}
  .skill-head{margin:0 0 12px;font-family:var(--display);font-weight:700;font-size:1.05rem}
  .skill-list{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:8px}
  .skill-group:nth-child(n+3) .skill-list{flex-direction:column;align-items:flex-start}
  .skill-list li{font-size:13.5px;line-height:1.3;color:var(--ink-soft);border:1px solid var(--line-2);border-radius:100px;padding:7px 12px;white-space:nowrap}
  @media (max-width:560px){.skill-list li{white-space:normal}}

</style>
