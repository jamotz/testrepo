---
import Logo from './Logo.astro';
---
<section class="hero" id="hero">
  <span class="hero-watermark" aria-hidden="true"><Logo /></span>

  <div class="wrap hero-inner">
    <div class="hero-top mono-label">
      <span>[ Portfolio / ’26 ]</span>
      <span class="hero-top-right">
        <span>Southwest · USA</span>
        <span class="live"><span class="dot"></span>Open to work</span>
      </span>
    </div>

    <div class="hero-body">
      <p class="hero-eyebrow"><span class="hero-idx">01</span><span class="rule"></span>UX Researcher &amp; Designer</p>

      <h1 class="hero-name" data-hero-name>
        <span class="line"><span>Jack</span></span>
        <span class="line"><span class="accent">Motzkin</span></span>
      </h1>

      <div class="hero-sub" data-reveal>
        <span class="tag">User research</span>
        <span class="tag">Accessibility</span>
        <span class="tag">Information architecture</span>
        <span class="tag">Business analysis</span>
      </div>

      <p class="hero-desc" data-reveal>
        I sit down with the people who use a product, watch where they get stuck, and turn
        what I find into designs and service changes a team can actually ship. So far: a
        charity’s support site, a dispensary’s shopping app, and a pack-out company’s
        customer journey.
      </p>

      <div class="hero-actions" data-reveal>
        <a class="btn btn-primary" href="#projects">
          View projects
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9m0 0-4-4m4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a class="btn btn-ghost" href="#contact">Get in touch</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero{position:relative;min-height:100dvh;display:flex;align-items:stretch;
    padding-top:74px;overflow:hidden}
  .hero-inner{flex:1;display:flex;flex-direction:column;width:100%}
  .hero-watermark{position:absolute;right:-8%;top:50%;transform:translateY(-50%);
    width:min(58vw,720px);aspect-ratio:1;color:var(--ink);opacity:.07;pointer-events:none;z-index:0}

  .hero-top{display:flex;justify-content:space-between;align-items:center;padding:24px 0;gap:16px}
  .hero-top-right{display:flex;gap:22px}
  .live{display:inline-flex;align-items:center;gap:8px;color:var(--acid)}
  .live .dot{width:7px;height:7px;border-radius:50%;background:var(--acid);
    box-shadow:0 0 0 0 rgba(198,242,78,.6);animation:live-pulse 2.4s infinite}
  @keyframes live-pulse{0%{box-shadow:0 0 0 0 rgba(198,242,78,.55)}70%{box-shadow:0 0 0 8px rgba(198,242,78,0)}100%{box-shadow:0 0 0 0 rgba(198,242,78,0)}}

  .hero-body{flex:1;display:flex;flex-direction:column;justify-content:center;padding:24px 0 clamp(48px,8vh,96px)}
  .hero-eyebrow{display:flex;align-items:center;gap:14px;font-family:var(--mono);
    font-size:12.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);margin-bottom:22px}
  .hero-idx{font-family:var(--display);font-weight:700;color:var(--ink);font-size:14px}
  .hero-eyebrow .rule{height:1px;width:min(120px,16vw);background:var(--line-2)}

  .hero-name{font-size:clamp(3.4rem,15.5vw,13rem);text-transform:uppercase;
    letter-spacing:-.035em;line-height:.82}
  .hero-name .line{display:block;overflow:hidden;padding-bottom:.02em}
  .hero-name .accent{color:var(--gold)}

  .hero-sub{display:flex;flex-wrap:wrap;gap:12px 24px;align-items:center;margin-top:28px}
  .hero-sub .tag{font-family:var(--mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase;
    color:var(--ink-soft);border:1px solid var(--line-2);border-radius:100px;padding:7px 14px}

  .hero-desc{max-width:52ch;margin-top:26px;font-size:clamp(1rem,1.6vw,1.15rem);
    line-height:1.7;color:var(--ink-soft)}

  .hero-actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:34px}



  @media (max-width:760px){
    .hero-top-right .live{display:none}
    .hero-name{letter-spacing:-.02em}
  }
  @media (prefers-reduced-motion:reduce){
    .live .dot{animation:none}
  }
</style>
